{
  "manifest_version": 3,
  "name": "Newtab Clock",
  "version": "0.1.0",
  "description": "A private, minimal new tab page with a local clock and date.",
  "permissions": [],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "Newtab Clock"
  }
}
